<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:id="@+id/widget_header_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_img_logo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_quiz" />

            <TextView
                android:id="@+id/widget_tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quizee"
                android:textColor="#818CF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tv_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_widget_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Economics"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_header_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_tv_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="🔥 3 Streak"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/widget_btn_refresh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Refresh Question"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Question Container (Card surface, takes flexible space, centers text nicely) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/widget_tv_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="8"
            android:text="Loading Question..."
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4 Option Buttons (Clean proportions, 46dp min height, no giant empty gaps) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/widget_btn_opt1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_widget_option_default"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="A. Option 1"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="12.5sp" />

        <Button
            android:id="@+id/widget_btn_opt2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_widget_option_default"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="B. Option 2"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="12.5sp" />

        <Button
            android:id="@+id/widget_btn_opt3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_widget_option_default"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="C. Option 3"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="12.5sp" />

        <Button
            android:id="@+id/widget_btn_opt4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:background="@drawable/bg_widget_option_default"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="D. Option 4"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Bottom Footer (Feedback & Next Button) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/widget_tv_feedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/widget_btn_next"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tap an option to answer"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_btn_next"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_widget_btn_next"
            android:minWidth="80dp"
            android:paddingHorizontal="12dp"
            android:text="Next ➔"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </RelativeLayout>
</LinearLayout>
