<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Top handle / bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_option_default" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPaletteTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Question Palette (100 Questions)"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnClosePalette"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_cross"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Legend bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="@color/card_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <!-- Answered -->
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_palette_answered" />

        <TextView
            android:id="@+id/tvLegendAnswered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="10dp"
            android:text="Ans: 0"
            android:textColor="@color/correct_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Marked -->
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_palette_marked" />

        <TextView
            android:id="@+id/tvLegendMarked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="10dp"
            android:text="Marked: 0"
            android:textColor="@color/warning_amber"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Unattempted -->
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_palette_unattempted" />

        <TextView
            android:id="@+id/tvLegendUnattempted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Left: 100"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Grid of 100 Questions -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPaletteGrid"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="never"
        android:scrollbars="vertical" />

</LinearLayout>
