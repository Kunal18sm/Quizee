<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Header Bar (No collision between left and right) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:id="@+id/widget_header_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_tv_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="🔥 1 Streak"
                android:textColor="#F59E0B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/widget_btn_refresh"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Refresh Question"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_header_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/widget_header_right"
            android:layout_marginEnd="6dp"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_img_logo"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_quiz" />

            <TextView
                android:id="@+id/widget_tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quizee"
                android:textColor="#818CF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tv_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_widget_badge"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="English"
                android:textColor="#94A3B8"
                android:textSize="9.5sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Question Text (Always wrap_content: NEVER squeezed into 1 line!) -->
    <TextView
        android:id="@+id/widget_tv_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="5dp"
        android:ellipsize="end"
        android:lineSpacingExtra="1.5dp"
        android:maxLines="4"
        android:text="Loading Question..."
        android:textColor="#F8FAFC"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <!-- 4 Option Buttons (Fill remaining height smoothly) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <Button
            android:id="@+id/widget_btn_opt1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_widget_option_default"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="A. Option 1"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_btn_opt2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_widget_option_default"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="B. Option 2"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_btn_opt3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_widget_option_default"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="C. Option 3"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_btn_opt4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_option_default"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="2"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="D. Option 4"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom Footer (Feedback & Next Button) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_tv_feedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/widget_btn_next"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tap an option to answer"
            android:textColor="#94A3B8"
            android:textSize="10.5sp" />

        <Button
            android:id="@+id/widget_btn_next"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_widget_btn_next"
            android:minWidth="65dp"
            android:paddingHorizontal="8dp"
            android:text="Next ➔"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </RelativeLayout>
</LinearLayout>
