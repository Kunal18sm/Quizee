<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/floating_scrim"
    android:clickable="true"
    android:focusable="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:overScrollMode="never">

        <!-- Floating Dialog Card (Compact & Centered) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDialogContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="24dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="24dp"
            app:cardElevation="20dp"
            app:strokeColor="@color/border_dark"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header: Target App Info & Lock Badge -->
                <LinearLayout
                    android:id="@+id/layoutDialogHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_dark_elevated"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:id="@+id/ivLockedAppIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="Locked App Icon"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLockedAppName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="App Locked"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLockedAppSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Answer 5 MCQs to unlock"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivHeaderLockBadge"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/warning_amber" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_dark" />

                <!-- 1. ACTIVE QUIZ VIEW -->
                <LinearLayout
                    android:id="@+id/layoutActiveQuiz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"
                    android:visibility="visible">

                    <!-- Progress Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvQuestionProgress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Question 1 of 5"
                            android:textColor="@color/accent"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScoreBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Score: 0"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressBar"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="8dp"
                        android:max="5"
                        android:progress="1"
                        app:indicatorColor="@color/accent"
                        app:trackColor="@color/card_dark_elevated"
                        app:trackCornerRadius="3dp" />

                    <!-- Question Container -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/card_dark_elevated"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/border_dark"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tvCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="General Knowledge"
                                android:textColor="@color/accent"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvQuestionText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:lineSpacingExtra="3dp"
                                android:text="What is the capital city of France?"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Options Container -->
                    <LinearLayout
                        android:id="@+id/layoutOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <!-- Option A -->
                        <FrameLayout
                            android:id="@+id/btnOption0"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_option_default"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvOptionBadge0"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:background="@drawable/bg_card"
                                    android:backgroundTint="#2B384E"
                                    android:gravity="center"
                                    android:text="A"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvOptionText0"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:text="Option A"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp" />

                                <ImageView
                                    android:id="@+id/ivFeedback0"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Option B -->
                        <FrameLayout
                            android:id="@+id/btnOption1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_option_default"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvOptionBadge1"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:background="@drawable/bg_card"
                                    android:backgroundTint="#2B384E"
                                    android:gravity="center"
                                    android:text="B"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvOptionText1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:text="Option B"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp" />

                                <ImageView
                                    android:id="@+id/ivFeedback1"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Option C -->
                        <FrameLayout
                            android:id="@+id/btnOption2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_option_default"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvOptionBadge2"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:background="@drawable/bg_card"
                                    android:backgroundTint="#2B384E"
                                    android:gravity="center"
                                    android:text="C"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvOptionText2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:text="Option C"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp" />

                                <ImageView
                                    android:id="@+id/ivFeedback2"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Option D -->
                        <FrameLayout
                            android:id="@+id/btnOption3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_option_default"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvOptionBadge3"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:background="@drawable/bg_card"
                                    android:backgroundTint="#2B384E"
                                    android:gravity="center"
                                    android:text="D"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvOptionText3"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:text="Option D"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp" />

                                <ImageView
                                    android:id="@+id/ivFeedback3"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </FrameLayout>

                    </LinearLayout>

                    <!-- Exit to Home Text Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExitHome"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Exit to Home Screen"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- 2. QUIZ COMPLETED VIEW (With "OPEN APP" BUTTON) -->
                <LinearLayout
                    android:id="@+id/layoutQuizCompleted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone">

                    <!-- Celebratory / Status Icon Badge -->
                    <FrameLayout
                        android:id="@+id/flCompletedBadge"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_card"
                        android:backgroundTint="#064E3B">

                        <ImageView
                            android:id="@+id/ivCompletedIcon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_unlock"
                            app:tint="@color/correct_green" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvCompletedTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="🎉 Quiz Completed!"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCompletedSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="You answered all 5 MCQs.\nYour app is now unlocked!"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvFinalScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_card"
                        android:backgroundTint="#1F2B3E"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp"
                        android:text="Score: 5 / 5 Correct"
                        android:textColor="@color/correct_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Prominent OPEN APP Button (Shown when score >= 3) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenApp"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="22dp"
                        android:text="OPEN APP"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/correct_green"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_unlock"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconSize="22dp"
                        app:iconTint="@color/white" />

                    <!-- Prominent RETRY & REVISE Button (Shown when score < 3) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetryQuiz"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="22dp"
                        android:text="RETRY &amp; REVISE (SAME QUESTIONS)"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_quiz"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconSize="20dp"
                        app:iconTint="@color/white" />

                    <!-- Optional Exit Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExitCompleted"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Exit to Home"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>
